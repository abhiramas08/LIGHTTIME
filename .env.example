# LIGHTTIME – Human-Centred Autonomous Lunar Mission Simulator
# Environment Configuration Template (Zero Database Required)

# Application Environment
VITE_APP_NAME="LIGHTTIME"
VITE_APP_ENV="development"
VITE_APP_VERSION="0.1.0"

# NASA Open APIs (Optional for live space weather / ephemeris validation)
# Operates out-of-the-box with built-in resilient offline fallback data
VITE_NASA_API_KEY="DEMO_KEY"
VITE_NASA_API_BASE_URL="https://api.nasa.gov"
VITE_NASA_DONKI_ENDPOINT="/DONKI"

# AI Mission Instructor (Optional Cloud Backend Proxy)
# Operates out-of-the-box using the local autonomous educational knowledge engine
# VITE_AI_INSTRUCTOR_ENDPOINT="/api/instructor"

# Simulation Configuration Defaults
# Lunar distance average: 384,400 km
# One-way speed of light: ~1.282 seconds (Round-trip: 2.564 seconds)
VITE_SIM_LIGHT_TIME_DELAY_SEC="1.28"
VITE_SIM_DEFAULT_SPEED_MULTIPLIER="1"
VITE_SIM_MISSION_DAYS_TOTAL="30"
